{
  "manifest_version": 3,
  "name": "Ulbraflow - Capturar e-mail como tarefa",
  "description": "Classifique o e-mail por área e data e inclua na esteira do Ulbraflow sem sair do Gmail.",
  "version": "1.4.1",
  "action": {
    "default_title": "Configurar conexão com o Ulbraflow",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "flow-mark.png"
    }
  },
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://flow-blue-theta.vercel.app/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "shared.js",
        "gmail.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "flow-mark.png"
  }
}
