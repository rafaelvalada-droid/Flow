# Na Vercel, configure em Project Settings > Environment Variables.
# Nunca coloque valores reais de chaves no GitHub.
GEMINI_API_KEY=
# Senha distinta da API Key. Escolha uma frase forte e exclusiva.
FLOW_AI_ACCESS_TOKEN=
# Opcional: identificador de modelo Gemini permitido em Interactions API.
GEMINI_MODEL=gemini-3.8-flash

# Google login + private storage (public client configuration only).
# Create the Supabase project, run supabase/flow.sql, then enable Google Auth.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Fail closed even if the two values above are missing. Enable after setup.
FLOW_REQUIRE_AUTH=false
