# Na Vercel, configure em Project Settings > Environment Variables.
# Nunca coloque valores reais de chaves no GitHub.
GEMINI_API_KEY=
# Senha distinta da API Key. Escolha uma frase forte e exclusiva.
FLOW_AI_ACCESS_TOKEN=
# Opcional: identificador de modelo Gemini permitido em Interactions API.
GEMINI_MODEL=gemini-3.8-flash

# Google login + private storage (public client configuration only).
# Create the Supabase project, run supabase/flow.sql, then enable Google Auth.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Fail closed even if the two values above are missing. Enable after setup.
FLOW_REQUIRE_AUTH=false

# Contas que podem usar a IA (Gemini) e a renovação Google. Vazio = qualquer conta Google.
# Separe por vírgula e-mails completos e/ou domínios iniciados por @. Ex.: chefe@exemplo.com,@ulbra.br
FLOW_ALLOWED_EMAILS=
# Opcional: limite diário de usos da IA por conta (padrão 300). Exige a função flow_ai_quota_hit de supabase/flow.sql.
FLOW_AI_DAILY_LIMIT=300
# Renovação automática do Gmail e da Agenda: mesmo cliente OAuth do provedor Google do Supabase.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
